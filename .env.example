# Public port on the client server
PORT=80

# Upstream RSD API. Browser talks to this host via nginx proxy (same-origin /api and /media).
API_UPSTREAM=https://rsd-ai.ru
API_HOST=rsd-ai.ru

# Bound to this cabinet only. Login for another automation is rejected.
VITE_AUTOMATION_ID=2

# Leave empty so the SPA uses same-origin /api (nginx proxies to API_UPSTREAM).
VITE_API_BASE_URL=

VITE_APP_NAME=SEO-Джарвис
VITE_APP_TAGLINE=Кабинет автоматизаций
